---
interface NavItem {
  label: string;
  href: string;
  icon: string;
  isCurrent: boolean;
}
interface Props {
  compact?: boolean;
  navigation: NavItem[];
}

const { compact, navigation } = Astro.props;

const wrapperClass = compact
  ? "flex items-center justify-between gap-6 px-3 py-2 mx-auto"
  : "flex items-center justify-between gap-6 px-6 py-4 mx-auto lg:container";
const logoWrapperClass = compact
  ? "flex items-center justify-center"
  : "flex items-center justify-center py-4";
const menuClass = compact
  ? "absolute left-auto hidden gap-1 menu bg-neutral-content md:bg-transparent rounded-box drop-shadow-xl md:menu-horizontal mt-14 md:mt-0 right-4 md:relative md:inset-x-0 w-60 md:w-full md:p-0"
  : "absolute left-auto hidden gap-1 menu bg-neutral-content lg:bg-transparent rounded-box drop-shadow-xl lg:menu-horizontal mt-14 lg:mt-0 right-5 lg:relative lg:inset-x-0 w-60 lg:w-full";
const menuItemClass = compact
  ? "gap-3 md:gap-1 p-4 md:px-3 md:py-2.5 active:bg-base-300"
  : "gap-3 lg:gap-1 p-4 lg:px-3.5 lg:py-3 active:bg-base-300";
---

<header>
  <div class={wrapperClass}>
    <div class={logoWrapperClass}>
      <a href="/" title="Crystalight Printcraft" class="rounded-md link">
        <img
          src="/logo.svg"
          width="484"
          height="83"
          class="w-full"
          style={`max-width: ${compact ? "240px" : "400px"};`}
        />
      </a>
    </div>
    <nav class="flex items-center justify-center shrink-0">
      <div class="z-50 flex flex-col w-full">
        <div class={compact ? "md:hidden" : "lg:hidden"}>
          <button
            id="menuOpen"
            class="w-full tracking-wider btn btn-outline rounded-box"
          >
            Menu
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-chevron-down"
              ><path d="m6 9 6 6 6-6"></path></svg
            >
          </button>
          <button
            id="menuClose"
            class="hidden w-full tracking-wider btn btn-outline rounded-box"
          >
            Close
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-chevron-up"
              ><path d="m18 15-6-6-6 6"></path></svg
            >
          </button>
        </div>
        <ul id="menu" class={menuClass}>
          {
            navigation.map((nav) => (
              <li>
                <a
                  href={nav.href}
                  title={nav.label}
                  class={`${menuItemClass} ${
                    nav.isCurrent
                      ? "isCurrent bg-primary hover:bg-primary-focus text-base-100 hover:text-base-100"
                      : null
                  }`}
                >
                  <img
                    src={`/icon-${nav.icon}-${
                      nav.isCurrent ? "light" : "dark"
                    }.svg`}
                    width="20px"
                    height="20px"
                  />
                  {nav.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>
  </div>
</header>

<script async>
const menuEl = document.getElementById("menu");
const menuOpenEl = document.getElementById("menuOpen");
const menuCloseEl = document.getElementById("menuClose");

const onMenuOpenClick = () => {
  menuEl?.classList.remove("hidden");
  menuOpenEl?.classList.add("hidden");
  menuCloseEl?.classList.remove("hidden");
};
const onMenuCloseClick = () => {
  menuEl?.classList.add("hidden");
  menuOpenEl?.classList.remove("hidden");
  menuCloseEl?.classList.add("hidden");
};

menuOpenEl?.addEventListener("click", onMenuOpenClick);
menuCloseEl?.addEventListener("click", onMenuCloseClick);
</script>

<style>
  #menu li a:not(.isCurrent):hover,
  #menu li a:not(.isCurrent):focus,
  #menu li a:not(.isCurrent):active {
    background-color: hsl(var(--nc) / var(--tw-bg-opacity));
    color: hsl(var(--bc) / var(--tw-text-opacity));
  }
</style>
