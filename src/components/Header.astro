---
interface NavItem {
  label: string;
  href: string;
  icon: string;
  isCurrent: boolean;
}
interface Props {
  navigation: NavItem[];
}

const { navigation } = Astro.props;
---

<header>
  <div class="container px-6 py-4 mx-auto">
    <div class="flex items-center justify-center pt-4 pb-6">
      <img
        src="logo.svg"
        width="484"
        height="83"
        class="w-full"
        style="max-width: 400px;"
      />
    </div>
    <nav class="flex justify-center items-center">
      <div class="w-full flex flex-col sm:items-center">
        <div class="sm:hidden">
          <button
            id="menuOpen"
            class="w-full btn btn-ghost bg-base-200 rounded-box"
          >
            Menu
            <img src="icon-chevron-down-dark.svg" width="20px" height="20px" />
          </button>
          <button
            id="menuClose"
            class="w-full btn btn-ghost bg-base-200 rounded-box hidden"
          >
            Close
            <img src="icon-chevron-up-dark.svg" width="20px" height="20px" />
          </button>
        </div>
        <ul
          id="menu"
          class="menu sm:menu-horizontal bg-base-200 rounded-box drop-shadow-xl gap-1 mt-14 sm:mt-0 absolute inset-x-5 sm:relative sm:inset-x-0 hidden"
        >
          {
            navigation.map((nav) => (
              <li>
                <a href={nav.href} class={nav.isCurrent ? "active" : null}>
                  <img
                    src={`icon-${nav.icon}-${
                      nav.isCurrent ? "light" : "dark"
                    }.svg`}
                    width="20px"
                    height="20px"
                  />
                  {nav.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>
  </div>
</header>

<script async>
const menuEl = document.getElementById("menu");
const menuOpenEl = document.getElementById("menuOpen");
const menuCloseEl = document.getElementById("menuClose");

const onMenuOpenClick = () => {
  menuEl?.classList.remove("hidden");
  menuOpenEl?.classList.add("hidden");
  menuCloseEl?.classList.remove("hidden");
};
const onMenuCloseClick = () => {
  menuEl?.classList.add("hidden");
  menuOpenEl?.classList.remove("hidden");
  menuCloseEl?.classList.add("hidden");
};

menuOpenEl?.addEventListener("click", onMenuOpenClick);
menuCloseEl?.addEventListener("click", onMenuCloseClick);
</script>
