---
import { unpackFlipBookZip } from "../utils/unpackFlipBookZip";
import { getMedia } from "../services/wpService";

interface Props {
  title: string;
  description?: string;
  fileId: number;
  imageId: number;
}
const { title, description, fileId, imageId } = Astro.props;

const image: string = (await getMedia(imageId)).source_url;
const fileURL: string = (await getMedia(fileId)).source_url;
const fileExt: string = fileURL.split(".").pop() || "";
let linkURL: string | undefined = fileURL;
if (fileExt === "zip") {
  const res = await fetch(fileURL);
  const zipBuffer = await res.arrayBuffer();
  const { rootPath } = await unpackFlipBookZip(zipBuffer);
  linkURL = rootPath;
}
---

<a
  href={linkURL}
  title={title}
  target="_blank"
  class="w-full max-w-sm mx-auto text-center transition-all card card-compact bg-neutral-content hover:-translate-y-2 hover:shadow-2xl"
>
  <figure class="h-56">
    <img src={image} alt={title} class="object-cover w-full" />
  </figure>
  <div class="card-body">
    <h2 class="justify-center font-semibold card-title">{title}</h2>
    {description && <p>{description}</p>}
  </div>
</a>
