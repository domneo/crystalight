---
import type { CatalogueProps } from "../utils/generateCatalogueData";
import { generateCatalogueData } from "../utils/generateCatalogueData";

interface Props extends CatalogueProps {}
const { title, description } = Astro.props;

const { url, image } = await generateCatalogueData(Astro.props);
---

<div class="text-center">
  <a
    href={url}
    title={title}
    class="flex gap-5 flex-row items-center sm:flex-col transition-colors hover:text-neutral-focus sm:max-w-96"
  >
    <div class="flex-shrink-0 self-start flex justify-center w-1/3 sm:w-auto">
      <figure class="flex justify-center">
        <img
          src={image}
          alt={title}
          class="object-contain transition-all rounded-lg hover:-translate-y-2 hover:shadow-2xl"
        />
      </figure>
    </div>
    <div class="text-start sm:text-center">
      <h2 class="justify-center text-lg sm:text-xl font-semibold text-balance" set:html={title} />
      {description && <p class="text-pretty mt-1">{description}</p>}
    </div>
  </a>
</div>
