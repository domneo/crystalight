---
import { getMedia } from "../services/wpService";

interface Props {
  title: string;
  description?: string;
  imageId: number;
  catalogueFormat: "pdf" | "flipbook";
  pdfFileId?: number;
  slug?: string;
}
const { title, description, imageId, catalogueFormat, pdfFileId, slug } =
  Astro.props;

const image: string = (await getMedia(imageId)).source_url;
const url =
  catalogueFormat === "pdf"
    ? (await getMedia(pdfFileId)).source_url
    : `/catalogues/${slug}`;
---

<a
  href={url}
  title={title}
  target={catalogueFormat === "pdf" ? "_blank" : "_self"}
  class="w-full max-w-sm mx-auto text-center transition-all card card-compact bg-neutral-content hover:-translate-y-2 hover:shadow-2xl"
>
  <figure class="h-56">
    <img src={image} alt={title} class="object-cover w-full" />
  </figure>
  <div class="card-body">
    <h2 class="justify-center font-semibold card-title">{title}</h2>
    {description && <p>{description}</p>}
  </div>
</a>
