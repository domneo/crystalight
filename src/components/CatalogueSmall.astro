---
import type { CatalogueProps } from "../utils/generateCatalogueData";
import { generateCatalogueData } from "../utils/generateCatalogueData";

interface Props extends CatalogueProps {}
const { title, description } = Astro.props;

const { url, image } = await generateCatalogueData(Astro.props);
---

<a
  href={url}
  title={title}
  class="grid row-span-2 grid-rows-subgrid gap-y-2 sm:gap-y-4 items-center transition-colors hover:text-neutral-focus max-w-96 mx-auto"
>
  <div class="flex-shrink-0 flex justify-center w-auto row-start-1 self-end">
    <figure class="flex justify-center">
      <img
        src={image}
        alt={title}
        class="object-contain transition-all rounded-lg hover:-translate-y-2 hover:shadow-2xl"
      />
    </figure>
  </div>
  <div class="text-center row-start-2 self-start">
    <h2
      class="justify-center text-md md:text-xl font-semibold text-balance"
      set:html={title}
    />
    {
      description && (
        <p class="text-xs md:text-sm text-pretty mt-1">{description}</p>
      )
    }
  </div>
</a>
