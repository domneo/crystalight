---
import type { CatalogueProps } from "../utils/generateCatalogueData";
import { generateCatalogueData } from "../utils/generateCatalogueData";

interface Props extends CatalogueProps {}
const { title, description, catalogueFormat } = Astro.props;

const { url, image } = await generateCatalogueData(Astro.props);
---

<div class="text-center">
  <a
    href={url}
    title={title}
    target={catalogueFormat === "pdf" ? "_blank" : "_self"}
    class="transition-colors hover:text-neutral-focus"
  >
    <div class="flex max-h-96">
      <figure class="flex justify-center">
        <img
          src={image}
          alt={title}
          class="object-contain rounded-lg transition-all hover:-translate-y-2 hover:shadow-2xl"
        />
      </figure>
    </div>
    <div class="my-4">
      <h2 class="justify-center text-xl font-semibold" set:html={title} />
      {description && <p>{description}</p>}
    </div>
  </a>
</div>
