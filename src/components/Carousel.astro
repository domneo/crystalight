---
const images = [
  { src: "/test.png" },
  { src: "/test.png" },
  { src: "/test.png" },
  { src: "/test.png" },
  { src: "/test.png" },
  { src: "/test.png" },
  { src: "/test.png" },
  { src: "/test.png" },
  { src: "/test.png" },
  { src: "/test.png" },
];
---

<div class="flex w-full overflow-hidden">
  <div class="flex images">
    {
      images.map((image) => (
        <div class="image">
          <img src={image.src} class="w-full" />
        </div>
      ))
    }
    {
      images.map((image) => (
        <div class="image">
          <img src={image.src} class="w-full" />
        </div>
      ))
    }
    {
      images.map((image) => (
        <div class="image">
          <img src={image.src} class="w-full" />
        </div>
      ))
    }
  </div>
</div>

<style>
  @keyframes marquee {
    from {
      translate: 0px;
    }
    to {
      translate: calc(10 * -300px);
    }
  }
  .images {
    animation: marquee 30s linear infinite;
  }
  .image {
    width: 160px;
    height: 160px;
  }
  @media (min-width: 768px) {
    .images {
      animation-duration: 25s;
    }
    .image {
      width: 240px;
      height: 240px;
    }
  }
  @media (min-width: 1024px) {
    .images {
      animation-duration: 20s;
    }
    .image {
      width: 300px;
      height: 300px;
    }
  }
</style>
