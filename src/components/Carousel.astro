---
const images = [
  { src: "/carousel/about-1.png" },
  { src: "/carousel/about-2.png" },
  { src: "/carousel/about-3.png" },
  { src: "/carousel/about-4.png" },
  { src: "/carousel/about-5.png" },
  { src: "/carousel/about-6.png" },
  { src: "/carousel/about-7.png" },
  { src: "/carousel/about-8.png" },
  { src: "/carousel/about-9.png" },
  { src: "/carousel/about-10.png" },
  { src: "/carousel/about-11.png" },
  { src: "/carousel/about-12.png" },
  { src: "/carousel/about-13.png" },
  { src: "/carousel/about-14.png" },
  { src: "/carousel/about-15.png" },
  { src: "/carousel/about-16.png" },
  { src: "/carousel/about-17.png" },
  { src: "/carousel/about-18.png" },
  { src: "/carousel/about-19.png" },
  { src: "/carousel/about-20.png" },
  { src: "/carousel/about-21.png" },
];
---

<div class="flex w-full overflow-hidden mt-8 mb-12">
  <div class="flex images">
    {
      images.map((image) => (
        <div class="image">
          <img src={image.src} class="w-full" />
        </div>
      ))
    }
    {
      images.map((image) => (
        <div class="image">
          <img src={image.src} class="w-full" />
        </div>
      ))
    }
    {
      images.map((image) => (
        <div class="image">
          <img src={image.src} class="w-full" />
        </div>
      ))
    }
  </div>
</div>

<style>
  @keyframes marquee {
    from {
      translate: 0px;
    }
    to {
      translate: calc(21 * -300px);
    }
  }
  .images {
    animation: marquee 60s linear infinite;
  }
  .image {
    width: 160px;
    height: 160px;
  }
  @media (min-width: 768px) {
    .images {
      animation-duration: 50s;
    }
    .image {
      width: 240px;
      height: 240px;
    }
  }
  @media (min-width: 1024px) {
    .images {
      animation-duration: 40s;
    }
    .image {
      width: 300px;
      height: 300px;
    }
  }
</style>
