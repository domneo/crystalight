import About9 from "../../public/carousel/about-9.png";
import About10 from "../../public/carousel/about-10.png";
import About11 from "../../public/carousel/about-11.png";
import About12 from "../../public/carousel/about-12.png";
import About13 from "../../public/carousel/about-13.png";
import About14 from "../../public/carousel/about-14.png";
import About15 from "../../public/carousel/about-15.png";
import About16 from "../../public/carousel/about-16.png";
import About17 from "../../public/carousel/about-17.png";
import About18 from "../../public/carousel/about-18.png";
import About19 from "../../public/carousel/about-19.png";
import About20 from "../../public/carousel/about-20.png";
import About21 from "../../public/carousel/about-21.png";

const images = [
  { src: About1 },
  { src: About2 },
  { src: About3 },
  { src: About4 },
  { src: About5 },
  { src: About6 },
  { src: About7 },
  { src: About8 },
  { src: About9 },
  { src: About10 },
  { src: About11 },
  { src: About12 },
  { src: About13 },
  { src: About14 },
  { src: About15 },
  { src: About16 },
  { src: About17 },
  { src: About18 },
  { src: About19 },
  { src: About20 },
  { src: About21 },
];
---

<div class="flex w-full overflow-hidden mt-8 mb-12">
  <div class="flex images">
    {
      images.map((image) => (
        <div class="image">
          <Image src={image.src} alt="" loading="eager" class="w-full" />
        </div>
      ))
    }
    {
      images.map((image) => (
        <div class="image">
          <Image src={image.src} alt="" loading="eager" class="w-full" />
        </div>
      ))
    }
    {
      images.map((image) => (
        <div class="image">
          <Image src={image.src} alt="" loading="eager" class="w-full" />
        </div>
      ))
    }
  </div>
</div>

<style>
  @keyframes marquee {
    from {
      translate: 0px;
    }
    to {
      translate: calc(21 * -300px);
    }
  }
  .images {
    animation: marquee 60s linear infinite;
  }
  .image {
    width: 160px;
    height: 160px;
  }
  @media (min-width: 768px) {
    .images {
      animation-duration: 50s;
    }
    .image {
      width: 240px;
      height: 240px;
    }
  }
  @media (min-width: 1024px) {
    .images {
      animation-duration: 40s;
    }
    .image {
      width: 300px;
      height: 300px;
    }
  }
</style>
