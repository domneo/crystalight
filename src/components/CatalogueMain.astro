---
import { getMedia } from "../services/wpService";

interface Props {
  title: string;
  description?: string;
  fileId: number;
  imageId: number;
  buttonText?: string;
  size?: "lg" | "sm";
}
const {
  title,
  description,
  fileId,
  imageId,
  buttonText = "View catalogue",
  size,
} = Astro.props;

const image: string = (await getMedia(imageId)).source_url;
const file: string = (await getMedia(fileId)).source_url;

const cardBodyWidths = size === "sm" ? "xl:w-2/3" : "md:w-2/3";
const cardBodyPadding = size === "sm" ? "py-12" : "py-12 lg:px-14";
const cardTitleSize =
  size === "sm"
    ? "text-2xl xl:text-3xl"
    : "text-2xl lg:text-4xl 2xl:text-5xl 2xl:mb-3";
---

<div class={`card-${size} card bg-base-100 shadow-xl image-full`}>
  <figure>
    <img src={image} alt={title} />
  </figure>
  <div
    class={`card-body justify-center rounded-l-2xl bg-gradient-to-r from-accent-content ${cardBodyWidths} ${cardBodyPadding}`}
  >
    <h2 class={`card-title ${cardTitleSize}`}>{title}</h2>
    {description && <p class="grow-0">{description}</p>}
    <div class="card-actions mt-4">
      <a href={file} target="_blank" class="btn btn-primary">
        {buttonText}
        <img src="icon-arrow-right-light.svg" width="20px" height="20px" />
      </a>
    </div>
  </div>
</div>

<style>
  .card-sm,
  .card-lg {
    width: 100%;
  }
  @media (min-width: 768px) {
    .card-sm {
      width: calc(50% - 8px);
    }
  }
  @media (min-width: 1024px) {
    .card-sm {
      width: calc(50% - 16px);
    }
  }
</style>
