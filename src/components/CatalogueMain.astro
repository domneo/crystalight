---
import { getMedia } from "../services/wpService";

interface Props {
  title: string;
  description?: string;
  fileId: number;
  imageId: number;
  buttonText?: string;
  size?: "lg" | "sm";
}
const {
  title,
  description,
  fileId,
  imageId,
  buttonText = "View catalogue",
  size,
} = Astro.props;

const image: string = (await getMedia(imageId)).source_url;
const file: string = (await getMedia(fileId)).source_url;

const cardBodyWidths = size === "sm" ? "xl:w-2/3" : "md:w-2/3";
const cardBodyPadding = size === "sm" ? "py-12" : "py-12 lg:px-14";
const cardTitleSize =
  size === "sm" ? "text-3xl xl:text-4xl" : "text-3xl lg:text-5xl 2xl:text-6xl";
---

<div class={`card-${size} card bg-base-100 shadow-xl image-full`}>
  <figure>
    <img src={image} alt={title} />
  </figure>
  <div
    class={`card-body justify-center rounded-l-2xl bg-gradient-to-r from-accent-content ${cardBodyWidths} ${cardBodyPadding}`}
  >
    <h2 class={`card-title ${cardTitleSize} font-display font-medium`}>
      {title}
    </h2>
    {description && <p class="grow-0">{description}</p>}
    <div class="card-actions mt-4 2xl:mt-6">
      <a
        href={file}
        target="_blank"
        class="btn btn-primary glass text-base-100 tracking-wider"
      >
        {buttonText}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-arrow-right"
          ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
        >
      </a>
    </div>
  </div>
</div>

<style>
  .card.image-full:before {
    opacity: 0.5;
  }

  .card-sm,
  .card-lg {
    width: 100%;
  }
  @media (min-width: 768px) {
    .card-sm {
      width: calc(50% - 8px);
    }
  }
  @media (min-width: 1024px) {
    .card-sm {
      width: calc(50% - 16px);
    }
  }
</style>
