---
import { getMedia } from "../services/wpService";

interface Props {
  title: string;
  description?: string;
  fileId: number;
  imageId: number;
  buttonText?: string;
  size?: "lg" | "sm";
}
const {
  title,
  description,
  fileId,
  imageId,
  buttonText = "View catalogue",
  size,
} = Astro.props;

const image: string = (await getMedia(imageId)).source_url;
const file: string = (await getMedia(fileId)).source_url;
---

<div
  class="h-64 overflow-hidden bg-center bg-cover rounded-md"
  style=`background-image: url('${image}');`
>
  <div class="flex items-center h-full bg-gray-900 bg-opacity-50">
    <div class="max-w-xl px-10">
      <h2 class="text-2xl font-semibold text-white">{title}</h2>
      {description && <p class="mt-2 text-gray-400">{description}</p>}
      <a
        href={file}
        class="flex items-center px-3 py-2 mt-4 text-sm font-medium text-white uppercase bg-blue-600 rounded hover:bg-blue-500 focus:outline-none focus:bg-blue-500"
      >
        <span>{buttonText}</span>
        <svg
          class="w-5 h-5 mx-2"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>
  </div>
</div>
