---
import { getMedia } from "../services/wpService";

interface Props {
  title: string;
  description?: string;
  imageId: number;
  catalogueFormat: "pdf" | "flipbook";
  pdfFileId?: number;
  slug?: string;
}
const { title, description, imageId, catalogueFormat, pdfFileId, slug } =
  Astro.props;

const image: string = (await getMedia(imageId)).source_url;
const url =
  catalogueFormat === "pdf"
    ? (await getMedia(pdfFileId)).source_url
    : `/catalogues/${slug}`;
---

<div class="w-full shadow-xl card bg-base-100 image-full">
  <figure>
    <img src={image} alt={title} />
  </figure>
  <div
    class="justify-center py-12 card-body rounded-l-2xl bg-gradient-to-r from-accent-content md:w-2/3 lg:px-14"
  >
    <h2
      class="text-3xl font-medium card-title lg:text-5xl 2xl:text-6xl font-display"
    >
      {title}
    </h2>
    {description && <p class="grow-0">{description}</p>}
    <div class="mt-4 card-actions 2xl:mt-6">
      <a
        href={url}
        title={"View catalogue"}
        target={catalogueFormat === "pdf" ? "_blank" : "_self"}
        class="tracking-wider btn btn-primary glass text-base-100"
      >
        View catalogue
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-arrow-right"
        >
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>
</div>

<style>
  .card.image-full:before {
    opacity: 0.5;
  }
</style>
