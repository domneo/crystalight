---
import type { CatalogueProps } from "../utils/generateCatalogueData";
import { generateCatalogueData } from "../utils/generateCatalogueData";

interface Props extends CatalogueProps {}
const { title, description, catalogueFormat } = Astro.props;

const { url, image } = await generateCatalogueData(Astro.props);
---

<div class="p-4 text-center md:p-8 xl:p-12 2xl:p-16 sm:w-2/3 md:w-1/2">
  <a
    href={url}
    title={title}
    target={catalogueFormat === "pdf" ? "_blank" : "_self"}
    class="transition-colors hover:text-neutral-focus"
  >
    <figure
      class="overflow-hidden rounded-lg transition-all hover:-translate-y-2 hover:shadow-2xl hover:-rotate-1"
    >
      <img src={image} alt={title} />
    </figure>
    <h2
      class="mt-4 mb-2 text-3xl font-medium lg:mt-6 lg:mb-4 lg:text-4xl 2xl:text-5xl font-display"
      set:html={title}
    />
    {description && <p class="grow-0">{description}</p>}
  </a>
</div>
