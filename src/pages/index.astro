---
import {
  getCatalogueCategories,
  getMainCatalogues,
  getSmallCatalogues,
} from "../services/wpService";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import CatalogueMain from "../components/CatalogueMain.astro";
import CatalogueSmall from "../components/CatalogueSmall.astro";

const mainCatalogues = await getMainCatalogues();
const smallCatalogues = await getSmallCatalogues();
const catalogueCategories = await getCatalogueCategories();
---

<Layout currentPage="home">
  <div
    class="flex flex-col justify-center h-full px-6 pt-2 pb-24 mx-auto lg:container"
  >
    <Hero
      images={[
        { src: "/banner1.jpg", title: "Welcome to Crystalight Printcraft" },
        { src: "/banner2.jpg", title: "Calendars" },
        { src: "/banner3.jpg", title: "Diaries" },
        { src: "/banner4.jpg", title: "Corporate Gifts" },
        { src: "/banner5.jpg", title: "Corporate Gifts" },
      ]}
    />
    <div
      class="flex flex-wrap justify-around w-full mx-auto mt-4 gap-4 md:gap-0 md:mt-4 2xl:mt-8"
    >
      {
        mainCatalogues.map((catalogue) => (
          <CatalogueMain
            title={catalogue.title.rendered}
            description={catalogue.acf.description}
            imageId={catalogue.acf.image}
            catalogueFormat={catalogue.acf.catalogue_format}
            pdfFileId={catalogue.acf.pdf_file}
            flipbookId={catalogue.acf.flipbook_id}
            slug={catalogue.acf.slug}
          />
        ))
      }
    </div>
    {
      catalogueCategories.map((category) => {
        const smallCataloguesFiltered = smallCatalogues.filter(
          (catalogue) => catalogue["catalogue-category"]?.[0] === category.id
        );
        if (smallCataloguesFiltered.length > 0) {
          return (
            <div class="w-full mt-16">
              <h2 class="mb-6 text-3xl lg:text-4xl font-display">
                {category.name}
              </h2>
              <div class="grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                {smallCataloguesFiltered.map((catalogue) => (
                  <CatalogueSmall
                    title={catalogue.title.rendered}
                    description={catalogue.acf.description}
                    imageId={catalogue.acf.image}
                    catalogueFormat={catalogue.acf.catalogue_format}
                    pdfFileId={catalogue.acf.pdf_file}
                    flipbookId={catalogue.acf.flipbook_id}
                    slug={catalogue.acf.slug}
                  />
                ))}
              </div>
            </div>
          );
        }
      })
    }
  </div>
</Layout>
