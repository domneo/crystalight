            <div class="px-5 py-3">
              <h3 class="text-gray-700 uppercase">Man Mix</h3>
              <span class="mt-2 text-gray-500">$12</span>
            </div>
          </div>
          <div
            class="w-full max-w-sm mx-auto overflow-hidden rounded-md shadow-md"
          >
            <div
