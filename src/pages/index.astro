---
import {
  getCatalogueCategories,
  getMainCatalogues,
  getSmallCatalogues,
} from "../services/wpService";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import CatalogueMain from "../components/CatalogueMain.astro";
import CatalogueSmall from "../components/CatalogueSmall.astro";

const mainCatalogues = await getMainCatalogues();
const smallCatalogues = await getSmallCatalogues();
const catalogueCategories = await getCatalogueCategories();
---

<Layout currentPage="home">
  <div
    class="flex flex-col justify-center h-full px-4 md:px-6 pt-8 sm:pt-12 pb-24 md:pb-32 xl:pb-48 mx-auto lg:container"
  >
    <Hero
      images={[
        {
          src: "/hero/banner7.jpg",
          title:
            "Welcome to Crystalight Printcraft – Calendars, Diaries & Notebooks, Corporate Gifts, Apparel",
        },
      ]}
    />
    <div
      class="flex flex-wrap justify-around w-full gap-4 mx-auto mt-4 md:gap-0 md:mt-4 2xl:mt-8"
    >
      {
        mainCatalogues.map((catalogue) => (
          <CatalogueMain
            title={catalogue.title.rendered}
            description={catalogue.acf.description}
            catalogueFormat={catalogue.acf.catalogue_format}
            imagePdfId={catalogue.acf.pdf_details.image_pdf}
            pdfFileId={catalogue.acf.pdf_details.pdf_file}
            imageFlipbookId={catalogue.acf.flipbook_details.image_flipbook}
            flipbookPostId={catalogue.acf.flipbook_details.flipbook_postid}
            slug={catalogue.acf.flipbook_details.slug}
          />
        ))
      }
    </div>
    {
      catalogueCategories.map((category) => {
        const smallCataloguesFiltered = smallCatalogues.filter(
          (catalogue) => catalogue["catalogue-category"]?.[0] === category.id,
        );
        if (smallCataloguesFiltered.length > 0) {
          return (
            <div class="w-full mt-16 md:mt-24">
              <h2 class="mb-6 text-3xl lg:text-4xl font-display">
                {category.name}
              </h2>
              <div class="grid grid-cols-2 gap-x-4 gap-y-8 sm:gap-8 lg:gap-12 sm:grid-cols-3 lg:grid-cols-3 xl:grid-cols-4 auto-rows-min">
                {smallCataloguesFiltered.map((catalogue) => (
                  <CatalogueSmall
                    title={catalogue.title.rendered}
                    description={catalogue.acf.description}
                    catalogueFormat={catalogue.acf.catalogue_format}
                    imagePdfId={catalogue.acf.pdf_details.image_pdf}
                    pdfFileId={catalogue.acf.pdf_details.pdf_file}
                    imageFlipbookId={
                      catalogue.acf.flipbook_details.image_flipbook
                    }
                    flipbookPostId={
                      catalogue.acf.flipbook_details.flipbook_postid
                    }
                    slug={catalogue.acf.flipbook_details.slug}
                  />
                ))}
              </div>
            </div>
          );
        }
      })
    }
  </div>
</Layout>
