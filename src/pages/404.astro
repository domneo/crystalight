---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found" currentPage="404">
  <div
    class="flex flex-col items-center justify-center h-full px-4 md:px-6 pt-8 sm:pt-12 pb-24 mx-auto text-center"
  >
    <p class="mb-6 text-sm tracking-wider uppercase text-base-content/60">
      Error 404
    </p>
    <h1 class="mb-6 text-4xl lg:text-5xl font-display text-balance">
      This page could not be found
    </h1>
    <p class="mb-2 text-pretty">
      The page you are looking for may have been moved, renamed, or is no longer
      available.
    </p>
    <p class="mb-2 text-pretty">
      Browse our catalogues from the home page, or get in touch and we will
      point you in the right direction.
    </p>
    <div class="flex flex-wrap justify-center gap-4 mt-8">
      <a href="/" class="btn btn-outline">Back to home</a>
      <a href="/contact" class="btn btn-outline">Contact us</a>
    </div>
  </div>
</Layout>
