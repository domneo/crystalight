---
import Layout from "../layouts/Layout.astro";

const address =
  "Block 13 Lorong 8 Toa Payoh #05-08 Braddell Tech Singapore 319261";
const addressLink = "https://goo.gl/maps/eeJd9wb75enDkeha8";
const telephone = "+65 6251 5313";
const telephoneLink = `tel:${telephone}`;
const fax = "+65 6254 5313";
const faxLink = `tel:${fax}`;
const email = "enquiry@crystalight.com.sg";
const emailLink = `mailto:${email}`;
---

<Layout currentPage="contact">
  <h1 class="mb-6 text-4xl font-display lg:text-5xl">Contact info</h1>
  <div class="grid gap-8 lg:grid-cols-2">
    <div class="w-full shadow-xl card bg-neutral-content">
      <div class="card-body">
        <div class="flex flex-col gap-6">
          <div class="flex items-center gap-4">
            <img
              src="icon-map-pin-dark.svg"
              width="24"
              height="24"
              class="shrink-0"
            />
            <p>
              <span class="inline-block mb-1 text-sm tracking-wider uppercase">
                Address
              </span>
              <br />
              <a
                href={addressLink}
                target="_blank"
                title={address}
                class="font-bold link"
              >
                {address}
              </a>
            </p>
          </div>
          <div class="flex items-center gap-4">
            <img
              src="icon-at-sign-dark.svg"
              width="24"
              height="24"
              class="shrink-0"
            />
            <p>
              <span class="inline-block mb-1 text-sm tracking-wider uppercase">
                Email
              </span>
              <br />
              <a
                href={emailLink}
                target="_blank"
                title={email}
                class="font-bold link"
              >
                {email}
              </a>
            </p>
          </div>
          <div class="flex items-center gap-4">
            <img
              src="icon-phone-dark.svg"
              width="24"
              height="24"
              class="shrink-0"
            />
            <p>
              <span class="inline-block mb-1 text-sm tracking-wider uppercase">
                Telephone
              </span>
              <br />
              <a
                href={telephoneLink}
                target="_blank"
                title={telephone}
                class="font-bold link"
              >
                {telephone}
              </a>
            </p>
          </div>
          <div class="flex items-center gap-4">
            <img
              src="icon-printer-dark.svg"
              width="24"
              height="24"
              class="shrink-0"
            />
            <p>
              <span class="inline-block mb-1 text-sm tracking-wider uppercase">
                Fax
              </span>
              <br />
              <a
                href={faxLink}
                target="_blank"
                title={fax}
                class="font-bold link"
              >
                {fax}
              </a>
            </p>
          </div>
        </div>
      </div>
    </div>
    <div class="w-full overflow-hidden rounded-2xl">
      <iframe
        width="100%"
        height="100%"
        style="border:0; min-height: 400px;"
        loading="lazy"
        allowfullscreen
        referrerpolicy="no-referrer-when-downgrade"
        src="https://www.google.com/maps/embed/v1/place?q=place_id:ChIJU_r9IXIX2jERJ06qfQRPbdg&key="
      >
      </iframe>
    </div>
  </div>
</Layout>
