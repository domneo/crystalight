---
import Layout from "../layouts/Layout.astro";

const phone = "+65 6251 5313";
const phoneLink = `tel:${phone}`;
const fax = "+65 6254 5313";
const faxLink = `tel:${fax}`;
const email = "enquiry@crystalight.com.sg";
const emailLink = `mailto:${email}`;
const address = `Block 13 Lorong 8 Toa Payoh #05-08 Braddell Tech Singapore 319261`;
const addressLink = "https://goo.gl/maps/eeJd9wb75enDkeha8";
const mapEmbedUrl = `https://www.google.com/maps/embed/v1/place?q=place_id:ChIJU_r9IXIX2jERJ06qfQRPbdg&key=${import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY}`;

const contactItems = [
  {
    label: "Phone",
    value: phone,
    link: phoneLink,
    icon: "/icon-phone-dark.svg",
  },
  {
    label: "Fax",
    value: fax,
    link: faxLink,
    icon: "/icon-printer-dark.svg",
  },
  {
    label: "Email",
    value: email,
    link: emailLink,
    icon: "/icon-at-sign-dark.svg",
  },
  {
    label: "Address",
    value: address,
    link: addressLink,
    icon: "/icon-map-pin-dark.svg",
  },
];
---

<Layout currentPage="contact">
  <div
    class="container flex flex-col justify-center h-full px-4 md:px-6 pt-8 sm:pt-12 pb-24 mx-auto"
  >
    <h1 class="mb-6 text-4xl font-display text-balance lg:text-5xl">Contact info</h1>
    <div class="grid lg:grid-cols-3">
      <div class="flex flex-col gap-6 px-3 pt-3 pb-6">
        {
          contactItems.map((contactItem) => (
            <div class="flex items-center gap-4">
              <img
                src={contactItem.icon}
                width="24"
                height="24"
                class="shrink-0"
              />
              <p>
                <span class="inline-block mb-1 text-sm tracking-wider uppercase">
                  {contactItem.label}
                </span>
                <br />
                <a
                  href={contactItem.link}
                  target="_blank"
                  title={contactItem.value}
                  class="font-bold link text-primary text-pretty"
                >
                  {contactItem.value}
                </a>
              </p>
            </div>
          ))
        }
      </div>
      <div class="pt-3 pb-6 md:px-3 lg:col-span-2 lg:pt-6">
        <div class="w-full overflow-hidden shadow-2xl rounded-xl">
          <iframe
            width="100%"
            height="100%"
            style="border:0; min-height: 400px;"
            loading="lazy"
            allowfullscreen
            referrerpolicy="no-referrer-when-downgrade"
            src={mapEmbedUrl}
          >
          </iframe>
        </div>
      </div>
    </div>
  </div>
</Layout>
