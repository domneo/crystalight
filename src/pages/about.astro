---
import Layout from "../layouts/Layout.astro";
import Carousel from "../components/Carousel.astro";
---

<Layout currentPage="about">
  <div class="flex flex-col items-center justify-center h-full">
    <div class="fixed mt-56 ml-48 lg:mt-48 bg-logo lg:ml-80 -z-50 opacity-5">
      <img
        src="/logo-icon-color.svg"
        alt="Crystalight Printcraft logo"
        class="w-full"
      />
    </div>
    <Carousel />
    <div class="max-w-3xl px-4 md:px-6 mx-auto mb-24">
      <h1 class="mb-6 text-5xl font-display text-balance">
        About Crystalight Printcraft
      </h1>
      <p class="mb-4 text-pretty">
        Welcome to Crystalight Printcraft. Established in 1987, we are one of
        Singapore's leading suppliers of calendars, diaries & notebooks,
        corporate gifts and apparel.
      </p>
      <p class="mb-4 text-pretty">
        With over 20 years of experience in the industry, we focus on offering
        our customers quality products, with an emphasis on design and
        end-product satisfaction. Our team of well-trained sales and production
        staff is dedicated to meeting our clients' requirements and delivery
        deadlines.
      </p>
      <p>
        At Crystalight Printcraft, we believe in providing good service, quality
        products, prompt delivery, and, most importantly, taking on new
        challenges!
      </p>
    </div>
  </div>
</Layout>

<style>
  .bg-logo {
    width: 95%;
  }
  @media (min-width: 640px) {
    .bg-logo {
      width: 85%;
    }
  }
  @media (min-width: 768px) {
    .bg-logo {
      width: 75%;
    }
  }
  @media (min-width: 1024px) {
    .bg-logo {
      width: 55%;
    }
  }
  @media (min-width: 1280px) {
    .bg-logo {
      width: 45%;
    }
  }
</style>
