---
import { GetStaticPathsResult } from "astro";
import {
  type Catalogue,
  getMainCatalogues,
  getMedia,
  getSmallCatalogues,
} from "../../../services/wpService";
import Layout from "../../../layouts/Layout.astro";

export async function getStaticPaths() {
  const generateSlugsFromCatalogues = (catalogues: Catalogue[]) => {
    let paths: GetStaticPathsResult = [];
    catalogues.forEach(async (catalogue) => {
      if (catalogue.acf.catalogue_format === "pdf") {
        paths.push({
          params: { id: catalogue.acf.pdf_file },
          props: { pdfFileID: catalogue.acf.pdf_file },
        });
      }
    });
    return paths;
  };

  const mainCatalogues = await getMainCatalogues();
  const smallCatalogues = await getSmallCatalogues();

  return [
    ...generateSlugsFromCatalogues(mainCatalogues),
    ...generateSlugsFromCatalogues(smallCatalogues),
  ];
}

const pdfFileUrl = (await getMedia(Astro.props.pdfFileID)).source_url;
---

<Layout currentPage="catalogues" compact>
  <pdf-viewer data-url={pdfFileUrl}>
    <iframe
      id="pdfViewer"
      title="PDF Catalogue"
      style="width:100%;height:100%;border:none;"></iframe>
  </pdf-viewer>
</Layout>

<!-- Load PDF.js -->
<script is:inline src="/pdfjs/build/pdf.js"></script>
<script is:inline src="/pdfjs/web/viewer.js"></script>
<link rel="stylesheet" href="/pdfjs/web/viewer.css" />

<!-- Load the PDF -->
<script is:inline>
class PdfViewer extends HTMLElement {
  constructor() {
    super();

    if (this.dataset.url) {
      const url = new URL(this.dataset.url);
      const origin =
        window?.location.origin === "http://localhost:3000"
          ? "http://localhost:8010/proxy" // use local proxy
          : url.origin;
      this.loadPdf(`${origin}${url.pathname}`);
    }
  }

  loadPdf(pdfUrl) {
    const iframe = document.querySelector("#pdfViewer");
    iframe.setAttribute("src", `/pdfjs/web/viewer.html?file=${pdfUrl}`);
  }
}
customElements.define("pdf-viewer", PdfViewer);
</script>
