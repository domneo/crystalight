---
import {
  type Catalogue,
  getMainCatalogues,
  getMedia,
  getSmallCatalogues,
} from "../../../services/wpService";
import Layout from "../../../layouts/Layout.astro";

export const prerender = false;

const { id } = Astro.params;

const findPdfFileID = (catalogues: Catalogue[]) =>
  catalogues.find(
    (catalogue) =>
      catalogue.acf.catalogue_format === "pdf" &&
      String(catalogue.acf.pdf_details.pdf_file) === id,
  )?.acf.pdf_details.pdf_file;

const [mainCatalogues, smallCatalogues] = await Promise.all([
  getMainCatalogues(),
  getSmallCatalogues(),
]);

const pdfFileID =
  findPdfFileID(mainCatalogues) ?? findPdfFileID(smallCatalogues);

if (!pdfFileID) {
  return new Response(null, { status: 404 });
}

const pdfFileUrl = (await getMedia(pdfFileID)).source_url;
const proxiedPdfFileUrl = `/api/pdf-proxy?url=${encodeURIComponent(pdfFileUrl)}`;
---

<Layout currentPage="catalogues" compact>
  <pdf-viewer data-url={proxiedPdfFileUrl}>
    <iframe
      id="pdfViewer"
      title="PDF Catalogue"
      style="width:100%;height:100%;border:none;"></iframe>
  </pdf-viewer>
</Layout>

<!-- Load PDF.js -->
<script is:inline src="/pdfjs/build/pdf.js"></script>
<script is:inline src="/pdfjs/web/viewer.js"></script>
<link rel="stylesheet" href="/pdfjs/web/viewer.css" />

<!-- Load the PDF -->
<script is:inline>
  class PdfViewer extends HTMLElement {
    constructor() {
      super();

      if (this.dataset.url) {
        this.loadPdf(this.dataset.url);
      }
    }

    loadPdf(pdfUrl) {
      const iframe = document.querySelector("#pdfViewer");
      iframe.setAttribute("src", `/pdfjs/web/viewer.html?file=${pdfUrl}`);
    }
  }
  customElements.define("pdf-viewer", PdfViewer);
</script>
