---
import {
  type Catalogue,
  getFlipbook,
  getMainCatalogues,
  getSmallCatalogues,
} from "../../../services/wpService";
import Layout from "../../../layouts/Layout.astro";

export const prerender = false;

const { slug } = Astro.params;

const findFlipbookID = async (catalogues: Catalogue[]) => {
  const flipbookPostID = catalogues.find(
    (catalogue) =>
      catalogue.acf.catalogue_format === "flipbook" &&
      catalogue.acf.slug === slug,
  )?.acf.flipbook;

  if (!flipbookPostID) {
    return undefined;
  }

  const flipbook = await getFlipbook(flipbookPostID);
  return flipbook.meta?.flipbook_id;
};

const [mainCatalogues, smallCatalogues] = await Promise.all([
  getMainCatalogues(),
  getSmallCatalogues(),
]);

const flipbookID =
  (await findFlipbookID(mainCatalogues)) ??
  (await findFlipbookID(smallCatalogues));

if (!flipbookID) {
  return new Response(null, { status: 404 });
}
---

<Layout currentPage="catalogues" compact>
  <iframe
    style="width:100%;height:100%"
    src={`https://admin.crystalight.com.sg/wp-content/uploads/flipbook/${flipbookID}/flipBook.html`}
    seamless="seamless"
    allowtransparency="true"
    allowfullscreen
  >
  </iframe>
</Layout>
