---
import {
  type Catalogue,
  getMainCatalogues,
  getSmallCatalogues,
} from "../../../services/wpService";
import Layout from "../../../layouts/Layout.astro";

export const prerender = false;

const { slug } = Astro.params;

const findFlipbookID = (catalogues: Catalogue[]) =>
  catalogues.find(
    (catalogue) =>
      catalogue.acf.catalogue_format === "flipbook" &&
      catalogue.acf.slug === slug,
  )?.acf.flipbook_id;

const [mainCatalogues, smallCatalogues] = await Promise.all([
  getMainCatalogues(),
  getSmallCatalogues(),
]);

const flipbookID =
  findFlipbookID(mainCatalogues) ?? findFlipbookID(smallCatalogues);

if (!flipbookID) {
  return new Response(null, { status: 404 });
}
---

<Layout currentPage="catalogues" compact>
  <iframe
    style="width:100%;height:100%"
    src={`https://admin.crystalight.com.sg/wp-content/uploads/flipbook/${flipbookID}/flipBook.html`}
    seamless="seamless"
    allowtransparency="true"
    allowfullscreen
  >
  </iframe>
</Layout>
