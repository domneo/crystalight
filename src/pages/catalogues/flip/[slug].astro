---
import type { GetStaticPathsResult } from "astro";
import {
  type Catalogue,
  getMainCatalogues,
  getSmallCatalogues,
} from "../../../services/wpService";
import Layout from "../../../layouts/Layout.astro";

export async function getStaticPaths() {
  const generateSlugsFromCatalogues = (catalogues: Catalogue[]) => {
    let paths: GetStaticPathsResult = [];
    catalogues.forEach(async (catalogue) => {
      if (catalogue.acf.catalogue_format === "flipbook") {
        paths.push({
          params: { slug: catalogue.acf.slug },
          props: { flipbookID: catalogue.acf.flipbook_id },
        });
      }
    });
    return paths;
  };

  const mainCatalogues = await getMainCatalogues();
  const smallCatalogues = await getSmallCatalogues();

  return [
    ...generateSlugsFromCatalogues(mainCatalogues),
    ...generateSlugsFromCatalogues(smallCatalogues),
  ];
}

const { flipbookID } = Astro.props;
---

<Layout currentPage="catalogues" compact>
  <iframe
    style="width:100%;height:100%"
    src={`https://admin.crystalight.com.sg/wp-content/uploads/flipbook/${flipbookID}/flipBook.html`}
    seamless="seamless"
    allowtransparency="true"
    allowfullscreen
  >
  </iframe>
</Layout>
